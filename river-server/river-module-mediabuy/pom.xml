<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.river</groupId>
        <artifactId>river</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>river-module-mediabuy</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        mediabuy 模块 - 媒体投放
        包括：JS 200 跳转、Offer 缓存、点击日志
    </description>

    <dependencies>
        <!-- 依赖 affiliate 模块：复用 OfferDO/OfferService -->
        <dependency>
            <groupId>com.river</groupId>
            <artifactId>river-module-affiliate</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 业务组件 -->
        <dependency>
            <groupId>com.river</groupId>
            <artifactId>river-spring-boot-starter-biz-tenant</artifactId>
        </dependency>

        <!-- IP 地址解析：用于点击日志区域信息 -->
        <dependency>
            <groupId>com.river</groupId>
            <artifactId>river-spring-boot-starter-biz-ip</artifactId>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>com.river</groupId>
            <artifactId>river-spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.river</groupId>
            <artifactId>river-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>com.river</groupId>
            <artifactId>river-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <!-- Redis 相关：用于 Offer 缓存 -->
        <dependency>
            <groupId>com.river</groupId>
            <artifactId>river-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>com.river</groupId>
            <artifactId>river-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>

