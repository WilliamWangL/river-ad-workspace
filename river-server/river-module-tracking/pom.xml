<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.river</groupId>
        <artifactId>river</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>river-module-tracking</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        tracking 模块 - 追踪与转化管理
        包括：点击记录、转化记录、追踪链接、归因记录等
    </description>

    <dependencies>
        <!-- 依赖 affiliate 模块 -->
        <dependency>
            <groupId>com.river</groupId>
            <artifactId>river-module-affiliate</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 依赖 coupon 模块（查询 Deal/Coupon 实体的 gotoUrl） -->
        <dependency>
            <groupId>com.river</groupId>
            <artifactId>river-module-coupon</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 业务组件 -->
        <dependency>
            <groupId>com.river</groupId>
            <artifactId>river-spring-boot-starter-biz-tenant</artifactId>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>com.river</groupId>
            <artifactId>river-spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.river</groupId>
            <artifactId>river-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>com.river</groupId>
            <artifactId>river-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>com.river</groupId>
            <artifactId>river-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 工具类相关 -->
        <dependency>
            <groupId>com.river</groupId>
            <artifactId>river-spring-boot-starter-excel</artifactId>
        </dependency>

        <!-- IP 解析相关（ip2region 中文区域解析） -->
        <dependency>
            <groupId>com.river</groupId>
            <artifactId>river-spring-boot-starter-biz-ip</artifactId>
        </dependency>

        <!-- MaxMind GeoIP2（ISO 国家代码解析） -->
        <dependency>
            <groupId>com.maxmind.geoip2</groupId>
            <artifactId>geoip2</artifactId>
            <version>4.2.0</version>
        </dependency>
    </dependencies>

</project>
